<Project Sdk="Microsoft.NET.Sdk">

  <!--
    canfxgen komut satırı aracı (dotnet tool). Kurulum komutları kökteki README'de.
    Rider / Visual Studio eklentileri de bunu JSON çıktısıyla çağırır.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>canfxgen</ToolCommandName>
    <PackageId>CanFx.Generator</PackageId>
    <AssemblyName>canfxgen</AssemblyName>
    <RootNamespace>CanFx.Generator</RootNamespace>
    <Description>canfxgen: CanFx çözümlerinde entity'den CRUD (CQRS) kodu üreten komut satırı aracı.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanFx.Generator.Engine\CanFx.Generator.Engine.csproj" />
  </ItemGroup>

</Project>
