<Project Sdk="Microsoft.NET.Sdk">

  <!--
    canfxgen'in motoru: çözümü bulur, entity'yi Roslyn ile okur, CRUD dosyalarını üretir ve işaretli yerlere
    (// canfxgen:...) ekleme yapar. CLI (canfxgen) ve IDE eklentileri (Rider, Visual Studio) bunu kullanır.
  -->
  <PropertyGroup>
    <!-- Ayrı paket olarak yayınlanmaz: canfxgen aracının (CanFx.Generator) içinde gelir; IDE eklentileri araçla çalışır. -->
    <IsPackable>false</IsPackable>
    <Description>CanFx çözümleri için kod üretici (entity → CQRS komut/sorgu, DTO, kurallar, yetkiler, EF yapılandırması, uç noktalar).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity dosyasını sözdizimi ağacıyla okumak için (yalnızca ayrıştırma; derleme yapılmaz). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanFx.Generator.Tests" />
  </ItemGroup>

</Project>
