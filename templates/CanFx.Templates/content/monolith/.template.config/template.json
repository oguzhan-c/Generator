{
  "$schema": "http://json.schemastore.org/template",
  "author": "Oğuzhan Can",
  "classifications": [
    "Web",
    "API",
    "Clean Architecture",
    "CanFx"
  ],
  "identity": "CanFx.Templates.Monolith",
  "groupIdentity": "CanFx.Templates.Monolith",
  "name": "CanFx Monolith",
  "shortName": "canfx-monolith",
  "description": "ASP.NET Core monolith Web API built on CanFx packages in the nArchitecture layout: Domain / Application (CQRS) / Persistence / Infrastructure / WebAPI (Controllers). Identity (JWT in HttpOnly cookies), 2FA, passkeys, multi-tenancy and external services are optional.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "preferNameDirectory": true,
  "forms": {
    "codeChars": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_.]",
      "replacement": "_"
    },
    "codeSegments": {
      "identifier": "replace",
      "pattern": "(^|\\.)([0-9])",
      "replacement": "${1}_${2}"
    },
    "codeName": {
      "identifier": "chain",
      "steps": [
        "codeChars",
        "codeSegments"
      ]
    },
    "lowerName": {
      "identifier": "lowerCaseInvariant"
    },
    "slugChars": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    },
    "slug": {
      "identifier": "chain",
      "steps": [
        "lowerName",
        "slugChars"
      ]
    }
  },
  "symbols": {
    "MultiTenancy": {
      "type": "parameter",
      "displayName": "Tenancy: Multi-tenancy",
      "description": "Multi-tenancy: the tenant travels in the token (cookie); data is separated by TenantId or by a database per tenant. Can be added later (canfxgen add feature multi-tenancy), but existing data must then be assigned to tenants; choosing it up front is easier.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Otp": {
      "type": "parameter",
      "displayName": "Security: OTP (authenticator app)",
      "description": "Two-step verification with TOTP (Google / Microsoft Authenticator). Can be added or removed later (canfxgen add feature otp; Rider: CanFx → Features).",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EmailTwoFactor": {
      "type": "parameter",
      "displayName": "Security: 2FA (email code)",
      "description": "Two-step verification with a code sent by email at sign-in. Can be added or removed later (canfxgen add feature email-two-factor).",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "TwoFactor": {
      "type": "computed",
      "value": "(Otp || EmailTwoFactor)"
    },
    "Passkey": {
      "type": "parameter",
      "displayName": "Security: Passkey (WebAuthn)",
      "description": "Passwordless sign-in: fingerprint / face recognition / security key. Can be added or removed later (canfxgen add feature passkey).",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "ExternalLogin": {
      "type": "parameter",
      "displayName": "Security: External login (Google, Microsoft, GitHub)",
      "description": "Sign in and link accounts with Google / Microsoft / GitHub. Can be added or removed later (canfxgen add feature external-login).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Redis": {
      "type": "parameter",
      "displayName": "Infrastructure: Redis",
      "description": "Distributed cache, Data Protection keys, rate limiting and locks (multiple servers).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EventBus": {
      "type": "parameter",
      "displayName": "Infrastructure: Event bus + outbox",
      "description": "Outbox / inbox tables and an in-process transport (no broker). You add Kafka / RabbitMQ / Azure Service Bus later yourself: the steps are in the TODO in Infrastructure/Messaging/EventBusServiceRegistration.cs.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Resilience": {
      "type": "parameter",
      "displayName": "Infrastructure: Resilience (retry, circuit breaker)",
      "description": "Standard resilience for all of the app's HttpClients (timeout, exponential retry, circuit breaker) and a named pipeline for your own code. Can be added later (canfxgen add feature resilience).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Hangfire": {
      "type": "parameter",
      "displayName": "Infrastructure: Hangfire",
      "description": "Persistent job queue, cron jobs and the /hangfire dashboard (when off: in-memory job scheduler).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "FileStorage": {
      "type": "parameter",
      "displayName": "Infrastructure: File storage",
      "description": "Local disk / S3 / Azure Blob.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Search": {
      "type": "parameter",
      "displayName": "Infrastructure: Search",
      "description": "In-memory search or Elasticsearch.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Realtime": {
      "type": "parameter",
      "displayName": "Infrastructure: Realtime notifications (SignalR)",
      "description": "Realtime notifications to a user or group; uses Redis as backplane when Redis is selected.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Sms": {
      "type": "parameter",
      "displayName": "Infrastructure: SMS",
      "description": "Sending SMS (writes to a folder in Development).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "AuditTrail": {
      "type": "parameter",
      "displayName": "Module: Audit trail",
      "description": "Writes changes of [Audited] entities to a table.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "Settings": {
      "type": "parameter",
      "displayName": "Module: Settings",
      "description": "Application settings stored in the database and changed through admin endpoints.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Reporting": {
      "type": "parameter",
      "displayName": "Module: Reporting",
      "description": "Report sources, saved reports, CSV / Excel / PDF export.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "OpenTelemetry": {
      "type": "parameter",
      "displayName": "Infrastructure: OpenTelemetry",
      "description": "Exports traces and metrics over OTLP (Aspire dashboard).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Postman": {
      "type": "parameter",
      "displayName": "Development: Postman sync",
      "description": "In Development, imports the API into a Postman collection and updates it on every start. Needs an API key (Postman:ApiKey in user-secrets or appsettings); without it nothing happens.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "IdKeyType": {
      "type": "parameter",
      "displayName": "Identity key type",
      "description": "Id type of the identity tables (users, roles, permissions, sessions ...). Chosen when the project is created: changing it after data exists affects every identity table and relation (canfxgen cannot change it later).",
      "datatype": "choice",
      "defaultValue": "guid",
      "choices": [
        {
          "choice": "guid",
          "description": "Guid v7 (generated in code, time ordered)"
        },
        {
          "choice": "int",
          "description": "int (generated by the database)"
        },
        {
          "choice": "long",
          "description": "long (generated by the database)"
        }
      ],
      "replaces": "CANFX_OPT_IDKEY"
    },
    "IdKeyClrType": {
      "type": "generated",
      "generator": "switch",
      "replaces": "IDKEY_CLR_TYPE",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(IdKeyType == \"int\")",
            "value": "System.Int32"
          },
          {
            "condition": "(IdKeyType == \"long\")",
            "value": "System.Int64"
          },
          {
            "condition": "",
            "value": "System.Guid"
          }
        ]
      }
    },
    "UserSecretsId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "USER_SECRETS_ID",
      "parameters": {
        "defaultFormat": "d"
      }
    },
    "AppCodeName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "codeName",
      "replaces": "CanAppTemplate",
      "fileRename": "CanAppTemplate",
      "description": "Name used in code, project and folder names: letters, digits, dots and underscores; a segment that starts with a digit gets an underscore prefix (CanFx.Shop-Api → CanFx.Shop_Api, Shop.1 → Shop._1)."
    },
    "AppSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "slug",
      "replaces": "canapptemplate",
      "description": "Name used for Docker, database, bucket and email domain names: lowercase letters, digits and hyphens (canfx-shop-api)."
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**",
        "**/*.user",
        "**/.idea/**",
        "**/.vs/**"
      ],
      "modifiers": [
        {
          "condition": "(!Passkey)",
          "exclude": [
            "src/CanAppTemplate.Application/Features/Account/Commands/BeginPasskeyRegistration/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/CompletePasskeyRegistration/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/DeletePasskey/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/RenamePasskey/**",
            "src/CanAppTemplate.Application/Features/Auth/Commands/PasskeyLogin/**",
            "src/CanAppTemplate.WebAPI/Security/PasskeyCeremonyStore.cs",
            "src/CanAppTemplate.Application/Services/AuthService/PasskeyDto.cs",
            "src/CanAppTemplate.Application/Services/AuthService/PasskeyLimits.cs"
          ]
        },
        {
          "condition": "(!Otp)",
          "exclude": [
            "src/CanAppTemplate.Application/Features/Account/Commands/BeginOtpSetup/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/EnableOtp/**",
            "src/CanAppTemplate.Application/Services/AuthService/OtpSetupDto.cs"
          ]
        },
        {
          "condition": "(!EmailTwoFactor)",
          "exclude": [
            "src/CanAppTemplate.Application/Features/Account/Commands/EnableEmailTwoFactor/**",
            "src/CanAppTemplate.Application/Features/Auth/Commands/ResendTwoFactorCode/**",
            "src/CanAppTemplate.Application/Services/AuthService/EmailMask.cs"
          ]
        },
        {
          "condition": "(!TwoFactor)",
          "exclude": [
            "src/CanAppTemplate.Application/Features/Auth/Commands/CompleteTwoFactorLogin/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/DisableTwoFactor/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/RegenerateRecoveryCodes/**",
            "src/CanAppTemplate.Application/Services/AuthService/TwoFactorChallenge.cs",
            "src/CanAppTemplate.Application/Services/AuthService/TwoFactorCodeVerifier.cs",
            "src/CanAppTemplate.Application/Services/AuthService/TwoFactorPrompt.cs",
            "src/CanAppTemplate.Application/Services/AuthService/RecoveryCodeIssuer.cs",
            "src/CanAppTemplate.Application/Services/AuthService/RecoveryCodesDto.cs",
            "src/CanAppTemplate.WebAPI/Security/TwoFactorCookie.cs"
          ]
        },
        {
          "condition": "(!MultiTenancy)",
          "exclude": [
            "src/CanAppTemplate.Persistence/Repositories/CrossTenantReader.cs",
            "src/CanAppTemplate.Application/Services/Repositories/ICrossTenantReader.cs"
          ]
        },
        {
          "condition": "(!ExternalLogin)",
          "exclude": [
            "src/CanAppTemplate.WebAPI/Security/ExternalLoginCallback.cs",
            "src/CanAppTemplate.Application/Features/Auth/Commands/ExternalLogin/**",
            "src/CanAppTemplate.Application/Features/Auth/Commands/LinkExternalLogin/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/UnlinkExternalLogin/**",
            "src/CanAppTemplate.Application/Services/AuthService/ExternalLoginDto.cs",
            "src/CanAppTemplate.Application/Services/AuthService/ExternalNames.cs"
          ]
        },
        {
          "condition": "(!Settings)",
          "exclude": [
            "src/CanAppTemplate.Application/Services/Settings/RuntimeSettings.cs"
          ]
        },
        {
          "condition": "(!Redis)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Caching/RedisServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Sms)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Sms/SmsServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!FileStorage)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/FileStorage/FileStorageServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Search)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Search/SearchServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!EventBus)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Messaging/EventBusServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Resilience)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Resilience/**"
          ]
        },
        {
          "condition": "(!Hangfire)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/BackgroundJobs/HangfireServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Realtime)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Realtime/RealtimeServiceRegistration.cs"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "CanAppTemplate.slnx"
    }
  ]
}
