{
  "$schema": "http://json.schemastore.org/template",
  "author": "Oğuzhan Can",
  "classifications": [
    "Web",
    "API",
    "Clean Architecture",
    "CanFx"
  ],
  "identity": "CanFx.Templates.Monolith",
  "groupIdentity": "CanFx.Templates.Monolith",
  "name": "CanFx Monolith",
  "shortName": "canfx-monolith",
  "description": "CanFx paketleriyle nArchitecture düzeninde monolith Web API: Domain / Application (CQRS) / Persistence / Infrastructure / WebAPI (Controllers). Kimlik (JWT HttpOnly cookie), 2FA, passkey, çoklu kiracılık ve dış servisler seçmeli.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "preferNameDirectory": true,
  "forms": {
    "codeName": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_.]",
      "replacement": "_"
    },
    "lowerName": {
      "identifier": "lowerCaseInvariant"
    },
    "slugChars": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    },
    "slug": {
      "identifier": "chain",
      "steps": [
        "lowerName",
        "slugChars"
      ]
    }
  },
  "symbols": {
    "Database": {
      "type": "parameter",
      "displayName": "Veritabanı",
      "description": "Veritabanı sağlayıcısı. Paket, bağlantı dizesi ve docker-compose servisi buna göre hazırlanır.",
      "datatype": "choice",
      "defaultValue": "postgresql",
      "choices": [
        {
          "choice": "postgresql",
          "description": "PostgreSQL"
        },
        {
          "choice": "sqlserver",
          "description": "SQL Server"
        },
        {
          "choice": "sqlite",
          "description": "SQLite (dosya; docker gerekmez)"
        }
      ]
    },
    "Postgres": {
      "type": "computed",
      "value": "(Database == \"postgresql\")"
    },
    "SqlServer": {
      "type": "computed",
      "value": "(Database == \"sqlserver\")"
    },
    "Sqlite": {
      "type": "computed",
      "value": "(Database == \"sqlite\")"
    },
    "MultiTenancy": {
      "type": "parameter",
      "displayName": "Tenancy: Multi-tenancy",
      "description": "Çoklu kiracılık: tenant token'da (cookie), veriler TenantId ile ya da tenant başına veritabanıyla ayrılır.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Otp": {
      "type": "parameter",
      "displayName": "Security: OTP (authenticator uygulaması)",
      "description": "TOTP ile iki adımlı doğrulama (Google/Microsoft Authenticator).",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EmailTwoFactor": {
      "type": "parameter",
      "displayName": "Security: 2FA (e-posta kodu)",
      "description": "Girişte e-postaya gönderilen kod ile iki adımlı doğrulama.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "TwoFactor": {
      "type": "computed",
      "value": "(Otp || EmailTwoFactor)"
    },
    "Passkey": {
      "type": "parameter",
      "displayName": "Security: Passkey (WebAuthn)",
      "description": "Şifresiz giriş: parmak izi / yüz tanıma / güvenlik anahtarı.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "ExternalLogin": {
      "type": "parameter",
      "displayName": "Security: Dış hesapla giriş",
      "description": "Google / Microsoft / GitHub ile giriş ve hesap bağlama.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Redis": {
      "type": "parameter",
      "displayName": "Altyapı: Redis",
      "description": "Dağıtık önbellek, Data Protection anahtarları, hız sınırı, kilit (çok sunucu).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EventBus": {
      "type": "parameter",
      "displayName": "Altyapı: Event bus + outbox",
      "description": "Outbox/inbox tabloları; süreç içi taşıyıcı, ayarla RabbitMQ.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Hangfire": {
      "type": "parameter",
      "displayName": "Altyapı: Hangfire",
      "description": "Kalıcı iş kuyruğu, cron ve /hangfire paneli (kapalıysa bellek içi iş zamanlayıcı).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "FileStorage": {
      "type": "parameter",
      "displayName": "Altyapı: Dosya depolama",
      "description": "Yerel disk / S3 / Azure Blob.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Search": {
      "type": "parameter",
      "displayName": "Altyapı: Arama",
      "description": "Bellek içi arama ya da Elasticsearch.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Realtime": {
      "type": "parameter",
      "displayName": "Altyapı: Anlık bildirim (SignalR)",
      "description": "Kullanıcıya/gruba anlık bildirim; Redis varsa backplane.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Sms": {
      "type": "parameter",
      "displayName": "Altyapı: SMS",
      "description": "SMS gönderimi (geliştirmede klasöre yazar).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "AuditTrail": {
      "type": "parameter",
      "displayName": "Modül: Değişiklik geçmişi (audit)",
      "description": "[Audited] entity'lerin değişikliklerini tabloya yazar.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "Settings": {
      "type": "parameter",
      "displayName": "Modül: Ayarlar",
      "description": "Veritabanında saklanan, yönetim uçlarından değiştirilen uygulama ayarları.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Reporting": {
      "type": "parameter",
      "displayName": "Modül: Raporlama",
      "description": "Rapor kaynakları, kayıtlı raporlar, CSV/Excel/PDF dışa aktarma.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "OpenTelemetry": {
      "type": "parameter",
      "displayName": "Modül: OpenTelemetry",
      "description": "İz ve metrikleri OTLP ile dışa aktarır (Aspire dashboard).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Postman": {
      "type": "parameter",
      "displayName": "Geliştirme: Postman eşitleme",
      "description": "Development'ta API'yi Postman koleksiyonuna aktarır ve her açılışta günceller. Anahtar user-secrets'ta (Postman:ApiKey); yoksa hiçbir şey yapmaz.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "IdKeyType": {
      "type": "parameter",
      "displayName": "Kimlik anahtar tipi",
      "description": "Kullanıcı, rol, yetki, oturum gibi kimlik tablolarının Id tipi. Sonradan Directory.Build.props'taki tek satırdan değiştirilebilir.",
      "datatype": "choice",
      "defaultValue": "guid",
      "choices": [
        {
          "choice": "guid",
          "description": "Guid v7 (kodda üretilir, zamana göre sıralı)"
        },
        {
          "choice": "int",
          "description": "int (veritabanı üretir)"
        },
        {
          "choice": "long",
          "description": "long (veritabanı üretir)"
        }
      ]
    },
    "IdKeyClrType": {
      "type": "generated",
      "generator": "switch",
      "replaces": "IDKEY_CLR_TYPE",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(IdKeyType == \"int\")",
            "value": "System.Int32"
          },
          {
            "condition": "(IdKeyType == \"long\")",
            "value": "System.Int64"
          },
          {
            "condition": "",
            "value": "System.Guid"
          }
        ]
      }
    },
    "UserSecretsId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "USER_SECRETS_ID",
      "parameters": {
        "defaultFormat": "d"
      }
    },
    "AppCodeName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "codeName",
      "replaces": "CanAppTemplate",
      "fileRename": "CanAppTemplate",
      "description": "Kod, proje ve klasör adlarında kullanılan ad: harf, rakam, nokta ve alt çizgi (CanFx.Shop-Api → CanFx.Shop_Api)."
    },
    "AppSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "slug",
      "replaces": "canapptemplate",
      "description": "Docker, veritabanı, bucket ve e-posta alan adlarında kullanılan ad: küçük harf, rakam ve tire (canfx-shop-api)."
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**",
        "**/*.user",
        "**/.idea/**",
        "**/.vs/**"
      ],
      "modifiers": [
        {
          "condition": "(!Passkey)",
          "exclude": [
            "src/CanAppTemplate.Application/Features/Account/Commands/BeginPasskeyRegistration/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/CompletePasskeyRegistration/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/DeletePasskey/**",
            "src/CanAppTemplate.Application/Features/Account/Commands/RenamePasskey/**",
            "src/CanAppTemplate.Application/Features/Auth/Commands/PasskeyLogin/**",
            "src/CanAppTemplate.WebAPI/Security/PasskeyCeremonyStore.cs"
          ]
        },
        {
          "condition": "(!MultiTenancy)",
          "exclude": [
            "src/CanAppTemplate.Persistence/Repositories/CrossTenantReader.cs",
            "src/CanAppTemplate.Application/Services/Repositories/ICrossTenantReader.cs"
          ]
        },
        {
          "condition": "(!ExternalLogin)",
          "exclude": [
            "src/CanAppTemplate.WebAPI/Security/ExternalLoginCallback.cs"
          ]
        },
        {
          "condition": "(!Settings)",
          "exclude": [
            "src/CanAppTemplate.Application/Services/Settings/RuntimeSettings.cs"
          ]
        },
        {
          "condition": "(!Redis)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Caching/RedisServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Sms)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Sms/SmsServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!FileStorage)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/FileStorage/FileStorageServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Search)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Search/SearchServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!EventBus)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Messaging/EventBusServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Hangfire)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/BackgroundJobs/HangfireServiceRegistration.cs"
          ]
        },
        {
          "condition": "(!Realtime)",
          "exclude": [
            "src/CanAppTemplate.Infrastructure/Realtime/RealtimeServiceRegistration.cs"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "CanAppTemplate.slnx"
    }
  ]
}
