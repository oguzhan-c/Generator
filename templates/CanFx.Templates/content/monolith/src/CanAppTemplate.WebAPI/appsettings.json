{
  "ConnectionStrings": {
    // Gerçek ortamın bağlantı dizesi burada DEĞİL: ortam değişkeni ConnectionStrings__CanAppTemplate (ya da user-secrets).
    // Geliştirmedeki yerel (docker) bağlantı dizesi appsettings.Development.json'da.
    "CanAppTemplate": ""
  },
  // Gizli değerler (JWT anahtarı, kod anahtarı, SMTP/SendGrid/S3 şifreleri, seed şifresi) burada DEĞİL, user-secrets'ta.
  "Security": {
    "Jwt": {
      // TODO(canfxgen): Issuer / Audience değerlerini uygulamana göre değiştir.
      "Issuer": "canapptemplate-api",
      "Audience": "canapptemplate-clients",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00"
    },
    // Token'lar yalnızca HttpOnly cookie'de taşınır (Authorization header'ı okunmaz).
    "Cookies": {
      "AccessTokenCookieName": "ca_at",
      "RefreshTokenCookieName": "ca_rt",
      // Yenileme, çıkış ve hesap güvenliği uçları /api/auth altında: refresh token yalnızca oraya gider.
      "RefreshTokenPath": "/api/auth"
    }
  },
//#if (MultiTenancy)
  // Tenant listesi. ConnectionString boşsa tenant ortak veritabanını kullanır (veri TenantId ile ayrılır).
  // TODO(canfxgen): Tenant'larını ekle; kendi veritabanı olan tenant'ın bağlantı dizesini user-secrets'a yaz.
  "MultiTenancy": {
    "Tenants": [
      { "Id": "0198a2c0-0000-7000-8000-000000000001", "Identifier": "default", "Name": "Varsayılan", "ConnectionString": "" }
    ]
  },
//#endif
  // Hız sınırı: genel 300 istek/dk (kullanıcı/IP), giriş/kayıt 10/dk (IP), kod gönderme ve şifre 5/15dk.
  "RateLimiting": {
    "Enabled": true
  },
//#if (EventBus)
  "Outbox": {
    "Interval": "00:00:05"
  },
//#endif
  "Mail": {
    // Pickup | Smtp | SendGrid
    "Provider": "Pickup",
    "From": "no-reply@canapptemplate.local"
  },
//#if (FileStorage)
  "Storage": {
    // Local | S3 | Azure
    "Provider": "Local"
  },
//#endif
  // Kod dağıtmadan açılıp kapanan özellikler (dosya değişince yeniden okunur).
  "Features": {
  },
  // Veritabanı sorgu tanılaması: yavaş sorgu, SQL etiketi, N+1 dedektörü.
  "QueryDiagnostics": {
    "SlowQueryThreshold": "00:00:00.300"
  },
  // Veri saklama: VARSAYILAN KAPALI, hiçbir kayıt silinmez. Açmak için Enabled = true (önce DryRun ile dene).
  "DataRetention": {
    "Enabled": false,
    "DryRun": true,
    "AuditLogsDays": 365,
    "SecurityEventsDays": 180,
    "SuccessfulLoginsDays": 30,
    "RequestActivitiesDays": 90,
    "ExpiredRefreshTokensDays": 30,
    "RevokedDevicesDays": 90
  },
  // İstek aktivite logu: VARSAYILAN KAPALI.
  "RequestActivityLog": {
    "Enabled": false,
    "IncludeReads": true
  },
  // Tarayıcı güvenliği: hepsi VARSAYILAN KAPALI (ön yüz kurulumuna göre açılır).
  "BrowserSecurity": {
    "SecurityHeaders": false,
    "CorsOrigins": [],
    "Csrf": false
  },
  // Yönetici hesabı: şifre user-secrets'ta ("Seed:AdminPassword"); şifre yoksa yönetici oluşturulmaz.
  "Seed": {
    "AdminEmail": "admin@canapptemplate.local"
  },
  "Database": {
    // Uygulama açılırken veritabanına ne yapılacağı:
    //   Migrate  : bekleyen migration'ları uygular; migration yoksa şemayı oluşturur. Veri korunur. (varsayılan)
    //   Recreate : siler ve güncel entity'lerden yeniden oluşturur (her açılışta temiz şema + seed). Yalnızca
    //              Development'ta ve yerel veritabanında çalışır; Production'da uygulama açılmaz.
    //   None     : dokunmaz (migration'lar ayrı bir adımda, ör. CI'da uygulanıyorsa).
    "StartupMode": "Migrate"
  },
  "AllowedHosts": "*"
}
