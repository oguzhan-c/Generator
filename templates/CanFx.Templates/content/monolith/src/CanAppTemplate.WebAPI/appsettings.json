{
  // ============================================================================================================
  // Uygulama ayarları. Tüm ortamların ortak değerleri burada; ortama özel farklar appsettings.{Ortam}.json'da
  // (yalnızca farklı olan değerler). Ortam değişkeni de her değeri ezer: "Security:Jwt:Issuer" → Security__Jwt__Issuer.
  //
  // GİZLİ DEĞERLER BURAYA YAZILMAZ (şifre, anahtar, bağlantı dizesi): geliştirmede user-secrets, sunucuda ortam
  // değişkeni ya da secret store (Key Vault ...). Gizli olanlar aşağıda "(gizli)" ile işaretli:
  //   cd src/CanAppTemplate.WebAPI && dotnet user-secrets set "Security:Jwt:SigningKey" "<en az 32 karakter>"
  //
  // Geçersiz ayar uygulamayı AÇILIŞTA durdurur (yanlış yazılmış anahtar, bilinmeyen değer, aralık dışı sayı); hata
  // mesajı hangi ayarın yanlış olduğunu söyler. Süreler: "gg.ss:dd:ss" ya da "ss:dd:ss" (ör. "00:15:00" = 15 dk).
  // ============================================================================================================

  "ConnectionStrings": {
    // (gizli) Veritabanı. Sunucuda ortam değişkeni: ConnectionStrings__CanAppTemplate. Geliştirmedeki yerel (docker)
    // bağlantı dizesi appsettings.Development.json'da.
    "CanAppTemplate": ""
  },

  "Database": {
    // Uygulama açılırken veritabanına ne yapılacağı:
    //   Migrate  : bekleyen migration'ları uygular; migration yoksa şemayı oluşturur. Veri korunur.
    //   Recreate : siler ve güncel entity'lerden yeniden oluşturur (her açılışta temiz şema + seed). Yalnızca
    //              Development'ta ve yerel veritabanında çalışır; başka yerde uygulama açılmaz.
    //   None     : dokunmaz (migration'lar ayrı bir adımda, ör. CI'da uygulanıyorsa).
    "StartupMode": "Migrate"
  },

  "Security": {
    "Jwt": {
      // TODO(canfxgen): Issuer / Audience değerlerini uygulamana göre değiştir.
      "Issuer": "canapptemplate-api",
      "Audience": "canapptemplate-clients",
      // Access token kısa ömürlüdür; süresi dolunca refresh token ile sessizce yenilenir.
      "AccessTokenLifetime": "00:15:00",
      // Refresh token: bu süre boyunca kullanılmazsa yeniden giriş gerekir.
      "RefreshTokenLifetime": "30.00:00:00",
      // Sunucular arası saat farkı toleransı.
      "ClockSkew": "00:00:30"
      // (gizli) "SigningKey": en az 32 karakter.
    },
    // (gizli) "VerificationCodeKey": e-posta / 2FA kodlarının imza anahtarı; en az 32 karakter, JWT anahtarından farklı.

    // Token'lar yalnızca HttpOnly cookie'de taşınır (JavaScript erişemez).
    "Cookies": {
      "AccessTokenCookieName": "ca_at",
      "RefreshTokenCookieName": "ca_rt",
      // Refresh token cookie'si yalnızca bu yola gönderilir (yenileme, çıkış, hesap güvenliği uçları).
      "RefreshTokenPath": "/api/auth",
      // Strict: başka sitelerden gelen isteklerle gönderilmez (CSRF koruması). Ön yüz başka bir sitedeyse (alan adı
      // farklı) None gerekir; o zaman BrowserSecurity:Csrf'i aç. Değerler: Strict | Lax | None.
      "SameSite": "Strict",
      // Yalnızca HTTPS. Yalnızca http://localhost'ta kapatılır (Development).
      "Secure": true,
      // Alt alan adlarıyla paylaşmak için (ör. ".example.com"); boşsa yalnızca bu alan adı.
      "Domain": null,
      // Authorization: Bearer header'ından da token kabul et (mobil istemci gibi). Varsayılan kapalı: yalnızca cookie.
      "AllowAuthorizationHeader": false
    }
//#if (Passkey)
    ,
    // Passkey (WebAuthn). Bölüm varsa passkey uçları açılır; ServerDomain ve Origins boşsa uygulama açılmaz.
    // TODO(canfxgen): Canlı alan adını yaz (Development'ta localhost değerleri appsettings.Development.json'da).
    "Passkey": {
      // Sitenin alan adı (şema ve port olmadan), ör. "example.com".
      "ServerDomain": "",
      // Kullanıcıya gösterilen ad.
      "ServerName": "CanAppTemplate",
      // Passkey'in kullanılabileceği adresler (ön yüz), ör. [ "https://example.com" ].
      "Origins": []
    }
//#endif
//#if (ExternalLogin)
    ,
    // Dış hesapla giriş. ClientId'si boş olan sağlayıcı kapalıdır. (gizli) ClientSecret'lar user-secrets'ta:
    //   dotnet user-secrets set "Security:External:Google:ClientSecret" "..."
    // Geri dönüş adresi (sağlayıcının panelinde): https://<alan adı>/api/auth/external/{google|microsoft|github}/callback
    "External": {
      "Google": { "ClientId": "" },
      "Microsoft": { "ClientId": "" },
      "GitHub": { "ClientId": "" }
    }
//#endif
  },
//#if (MultiTenancy)

  // Tenant listesi. ConnectionString boşsa tenant ortak veritabanını kullanır (veri TenantId ile ayrılır); doluysa
  // kendi veritabanını (gizli: user-secrets / ortam değişkeni).
  // TODO(canfxgen): Tenant'larını ekle. Tenant'lar veritabanında tutulacaksa listeyi boş bırak, kendi ITenantStore'unu kaydet.
  "MultiTenancy": {
    "Tenants": [
      { "Id": "0198a2c0-0000-7000-8000-000000000001", "Identifier": "default", "Name": "Varsayılan", "ConnectionString": "" }
    ]
  },
//#endif

  // İstek hız sınırları. Aşılınca 429 + Retry-After. Kural: Window içinde en fazla PermitLimit istek.
  //   SegmentsPerWindow: 1 = sabit pencere; >1 = kayan pencere (sınır anındaki patlamaları yumuşatır).
  //   PartitionBy: UserOrIp (giriş yapmışsa kullanıcı, yoksa IP) | Ip | Tenant (tenant'taki herkes tek sayaç).
  // Hepsi ayrıca tenant'a göre ayrılır. Redis açıksa sayaçlar sunucular arasında ortaktır.
  "RateLimiting": {
    // Kapalıysa hiçbir sınır uygulanmaz (ör. yük testi).
    "Enabled": true,
    // Tüm istekler.
    "Global": { "PermitLimit": 300, "Window": "00:01:00", "SegmentsPerWindow": 6, "PartitionBy": "UserOrIp" },
    // Giriş, kayıt, şifre sıfırlama (can-auth): kaba kuvvet denemelerine karşı.
    "Auth": { "PermitLimit": 10, "Window": "00:01:00", "SegmentsPerWindow": 1, "PartitionBy": "Ip" },
    // Kod gönderme, şifre değiştirme, 2FA (can-sensitive).
    "Sensitive": { "PermitLimit": 5, "Window": "00:15:00", "SegmentsPerWindow": 1, "PartitionBy": "UserOrIp" },
    // Uygulamanın kendi sınırları: ad → kural. Uca bağlamak: [EnableRateLimiting("reports")] (controller/action).
    // Uçta kullanılıp burada tanımlı olmayan ad uygulamayı açılışta durdurur (yazım hatası yakalanır).
    // Örnek: "reports": { "PermitLimit": 20, "Window": "00:01:00", "PartitionBy": "Tenant" }
    "Policies": {
    }
  },
//#if (EventBus)

  // Outbox: entegrasyon event'leri veritabanı işlemiyle birlikte kaydedilir, arka planda yayınlanır (kayıp olmaz).
  "Outbox": {
    // Bekleyen mesajların kontrol aralığı.
    "Interval": "00:00:05",
    // Bir turda en fazla kaç mesaj.
    "BatchSize": 50,
    // Toplam deneme; tükenince mesaj "ölü" olur, elle yeniden kuyruğa alınana kadar denenmez.
    "MaxAttempts": 10,
    // İlk hatadan sonraki bekleme; her hatada ikiye katlanır, en fazla MaxRetryDelay.
    "RetryBaseDelay": "00:00:05",
    "MaxRetryDelay": "01:00:00",
    // Bekleme süresine eklenen rastgele oynama (0-1): aynı anda hata alanlar aynı anda yeniden denenmesin.
    "RetryJitter": 0.2,
    // Mesaj işlenirken kilitli kalma süresi (işlemci çökerse sonra başkası alır); en uzun handler süresinden büyük olmalı.
    "LockDuration": "00:02:00",
    // Yayınlanmış mesajlar bu süre sonra silinir (null: hiç silinmez).
    "RetainProcessedMessagesFor": "7.00:00:00",
    // Ölü mesajlar bu süre sonra silinir (null: incelenebilsin diye silinmez).
    "RetainDeadMessagesFor": null
  },

  // Event bus. RabbitMq:ConnectionString boşsa süreç içi taşıyıcı (tek uygulama); doluysa RabbitMQ (servisler arası,
  // inbox ile tekrar gelen mesaj ayıklanır).
  "EventBus": {
    "RabbitMq": {
      // (gizli, şifre içerir) amqp://kullanıcı:şifre@host:5672/vhost — TLS için amqps://
      "ConnectionString": "",
      // Tüketici (kuyruk) adı: aynı servisin örnekleri aynı adı kullanır (iş paylaşır); boşsa uygulama adı.
      "ConsumerName": "canapptemplate",
      // Mesaj dinlensin mi (yalnızca yayınlayan servislerde kapat).
      "EnableConsumer": true,
      // Hata alınca aynı süreçte hemen kaç kez daha denensin; sonra gecikmeli denemeler (10 sn, 1 dk, 10 dk, 1 sa), en sonda DLQ.
      "ImmediateRetries": 2,
      "ImmediateRetryDelay": "00:00:00.200",
      // Event'lerin yayınlandığı topic exchange.
      "Exchange": "can.events",
      // quorum (önerilen: çoğaltılmış, kalıcı) | classic
      "QueueType": "quorum",
      // Onaylanmamış en fazla mesaj ve aynı anda işlenen mesaj sayısı.
      "PrefetchCount": 50,
      "ConsumerConcurrency": 8,
      // Exchange / kuyrukları açılışta oluştur (sunucuda yetki yoksa kapat; altyapı ekibi kurar).
      "DeclareTopology": true
    }
  },
//#endif

  // E-posta. Provider: Pickup (göndermez, .eml dosyası yazar) | Smtp | SendGrid.
  "Mail": {
    "Provider": "Pickup",
    // TODO(canfxgen): Gönderen adresini kendi alan adınla değiştir.
    "From": "no-reply@canapptemplate.local",
    // Pickup: .eml dosyalarının yazıldığı klasör (uygulamanın çalışma klasörüne göre).
    "PickupDirectory": "mails",
    "Smtp": {
      "Host": "",
      "Port": 587,
      // Auto | None | SslOnConnect | StartTls | StartTlsWhenAvailable
      "Security": "Auto",
      // Boşsa kimlik doğrulama yapılmaz. (gizli) "Password" user-secrets'ta: Mail:Smtp:Password
      "UserName": null,
      "FromAddress": "no-reply@canapptemplate.local",
      "FromName": "CanAppTemplate",
      "Timeout": "00:00:30",
      // Sertifika iptal kontrolü (macOS'ta iptal listesine ulaşılamazsa kapatılabilir).
      "CheckCertificateRevocation": true
    },
    "SendGrid": {
      // (gizli) "ApiKey" user-secrets'ta: Mail:SendGrid:ApiKey
      // SendGrid'de doğrulanmış gönderen olmalı.
      "FromAddress": "no-reply@canapptemplate.local",
      "FromName": "CanAppTemplate",
      // Açıksa SendGrid isteği doğrular ama göndermez (test).
      "SandboxMode": false,
      "Timeout": "00:00:30"
    }
  },
//#if (FileStorage)

  // Dosyalar. Provider: Local (disk) | S3 (AWS, MinIO, R2, SeaweedFS) | Azure (Blob Storage). Dosyalar tenant klasörüne yazılır.
  "Storage": {
    "Provider": "Local",
    "Local": {
      // Kök klasör (uygulamanın çalışma klasörüne göre ya da tam yol).
      "RootPath": "files"
    },
    "S3": {
      // AWS: https://s3.eu-central-1.amazonaws.com, MinIO/SeaweedFS: http://localhost:9000, R2: https://<hesap>.r2.cloudflarestorage.com
      "ServiceUrl": null,
      "Region": "us-east-1",
      "Bucket": "canapptemplate",
      // (gizli) "SecretAccessKey" user-secrets'ta: Storage:S3:SecretAccessKey
      "AccessKeyId": "",
      // true: https://servis/bucket/anahtar (MinIO, R2); false: https://bucket.servis/anahtar (AWS'nin önerdiği).
      "ForcePathStyle": true,
      // Bucket içinde tüm dosyaların önüne eklenen klasör.
      "KeyPrefix": null,
      "Timeout": "00:01:40"
    },
    "Azure": {
      // (gizli) Bağlantı dizesi ya da AccountName + AccountKey user-secrets'ta: Storage:Azure:ConnectionString
      "Container": "canapptemplate",
      // Boşsa https://{AccountName}.blob.core.windows.net
      "ServiceUrl": null,
      "KeyPrefix": null,
      // Container yoksa oluştur (geliştirme; canlıda önceden aç).
      "CreateContainerIfMissing": false,
      "Timeout": "00:01:40"
    }
  },
//#endif
//#if (Search)

  // Arama. Elasticsearch:Url boşsa bellek içi motor (tek sunucu, kalıcı değil); doluysa Elasticsearch / OpenSearch.
  "Search": {
    "Elasticsearch": {
      "Url": "",
      // Dizin adlarının öneki: aynı kümeyi paylaşan uygulama/ortamlar karışmasın.
      "IndexPrefix": "canapptemplate-",
      // Yazmadan sonra: None (hızlı, birkaç sn sonra görünür) | WaitFor (görünene kadar bekle) | Immediate
      "Refresh": "None",
      // Küme "meşgul" (429) dediğinde toplu yazmanın tekrar sayısı.
      "BulkRetries": 2,
      "EnableCompression": false,
      "Timeout": "00:00:30"
      // (gizli) "ApiKey" ya da "Username" + "Password" user-secrets'ta.
    }
  },
//#endif
//#if (Redis)

  // Redis: önbellek, Data Protection anahtarları, hız sınırı sayaçları ve dağıtık kilit sunucular arasında ortak olur.
  // Boşsa hepsi bellek içi (tek sunucu). (gizli, şifre içeriyorsa) "host:6379,password=..."
  "Redis": {
    "ConnectionString": ""
  },
//#endif
//#if (Hangfire)

  // Hangfire: kalıcı iş kuyruğu, cron ve /hangfire paneli (Admin). Kapalıysa bellek içi zamanlayıcı.
  "Hangfire": {
    "Enabled": true,
    // Aynı anda çalışan iş sayısı (null: işlemci sayısına göre).
    "WorkerCount": null
  },
//#endif
//#if (Sms)

  // SMS. Sağlayıcı bağlanana kadar mesajlar klasöre yazılır.
  "Sms": {
    "PickupDirectory": "sms"
  },
//#endif
//#if (OpenTelemetry)

  // İz ve metrikler (OTLP). docker compose --profile observability up -d dashboard → http://localhost:18888
  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "http://localhost:4317"
  },
//#endif

  // Kod dağıtmadan açılıp kapanan özellikler (dosya değişince yeniden okunur): "YeniOdeme": true
  "Features": {
  },

  // Veritabanı sorgu tanılaması.
  "QueryDiagnostics": {
    // Bundan uzun süren sorgu uyarı olarak loglanır.
    "SlowQueryThreshold": "00:00:00.300",
    // SQL'in başına kaynağını yazan yorum (-- can: GetProductsQuery): veritabanının yavaş sorgu listesinde bulunur.
    "TagQueries": true,
    // Sorgu süreleri metrik olarak yayınlanır.
    "RecordMetrics": true,
    "MaxLoggedSqlLength": 2000,
    // N+1 dedektörü: aynı SQL bir istekte bu kadar çalışırsa uyar (0: kapalı).
    "RepeatedQueryThreshold": 0,
    // Bir istekte bundan fazla sorgu çalışırsa uyar (0: kapalı).
    "MaxCommandsPerScope": 0,
    // Uyarı yerine hata fırlat (geliştirmede sorunu kaçırmamak için).
    "ThrowOnViolation": false
  },

  // Veri saklama: VARSAYILAN KAPALI, hiçbir kayıt silinmez. Açmak için Enabled = true (önce DryRun ile yalnızca say).
  // Süreler gün olarak.
  "DataRetention": {
    "Enabled": false,
    "DryRun": true,
    "AuditLogsDays": 365,
    "SecurityEventsDays": 180,
    "SuccessfulLoginsDays": 30,
    "RequestActivitiesDays": 90,
    "ExpiredRefreshTokensDays": 30,
    "RevokedDevicesDays": 90
  },

  // İstek aktivite logu (kim, ne zaman, hangi uç): VARSAYILAN KAPALI. Veritabanına toplu yazılır; istek beklemez.
  "RequestActivityLog": {
    "Enabled": false,
    "IncludeAnonymous": true,
    // Okuma istekleri (GET) de kaydedilsin mi; kapalıysa yalnızca veri değiştirenler.
    "IncludeReads": true,
    // Kayıtlar loga da yazılsın mı.
    "WriteToLog": false,
    // Bellekteki kuyruk; doluysa en eski kayıt düşer (istek asla beklemez).
    "Capacity": 10000,
    "BatchSize": 500,
    "FlushInterval": "00:00:02"
  },

  // Tarayıcı güvenliği: hepsi VARSAYILAN KAPALI (ön yüz kurulumuna göre açılır).
  "BrowserSecurity": {
    // Güvenlik başlıkları (CSP, HSTS, X-Frame-Options ...).
    "SecurityHeaders": false,
    // Ön yüz başka bir adresteyse izin verilen adresler, ör. [ "https://app.example.com" ].
    "CorsOrigins": [],
    // CSRF koruması (Cookies:SameSite = None ise aç).
    "Csrf": false
  },

  // Başlangıç verisi. Yönetici: (gizli) "Seed:AdminPassword" user-secrets'ta; şifre yoksa yönetici oluşturulmaz.
  "Seed": {
    "AdminEmail": "admin@canapptemplate.local"
  },

  // Loglar konsola yazılır; dosya yolu verilirse günlük dosyalara da (JSON).
  "Logs": {
    "FilePath": null
  },

  // Geliştirmeye özel ayarlar (DevServices, Postman) appsettings.Development.json'da.

  // İzin verilen Host başlıkları (";" ile ayrılmış); "*" hepsi. Canlıda alan adını yaz.
  "AllowedHosts": "*"
}
