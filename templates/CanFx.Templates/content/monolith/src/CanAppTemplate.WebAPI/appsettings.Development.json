{
  // Development: YALNIZCA appsettings.json'dan farklı olan değerler ve geliştirmeye özel ayarlar (DevServices, Postman).
  // Ayarların tamamı ve açıklamaları appsettings.json'da.

  "ConnectionStrings": {
    // Veritabanı (PersistenceServiceRegistration.cs → "Veritabanı"): seçtiğin sağlayıcının satırını aç, boş olanı sil.
    // İkisi de docker-compose.yml'deki servise bağlanır (yalnızca yerel geliştirme şifresi); DevServices o servisi
    // uygulama açılırken kendiliğinden başlatır. Kendi sunucunu kullanacaksan bağlantı dizesini user-secrets'a yaz.
    //   PostgreSQL:
    // "CanAppTemplate": "Host=localhost;Port=5432;Database=canapptemplate;Username=canapptemplate;Password=canapptemplate"
    //   SQL Server:
    // "CanAppTemplate": "Server=localhost,1433;Database=CanAppTemplate;User Id=sa;Password=CanAppTemplate_Dev_123;TrustServerCertificate=True"
    "CanAppTemplate": ""
  },

  // Her açılışta veritabanı silinip güncel entity'lerden yeniden oluşturulur ve seed (örnek veri dahil) çalışır.
  // İlk migration'ı ekleyince (dotnet ef migrations add Initial) Migrate yap: veri korunur.
  "Database": {
    "StartupMode": "Recreate"
  },

  "Security": {
    "Cookies": {
      // http://localhost için (canlıda HTTPS ile true).
      "Secure": false
    }
//#if (Passkey)
    ,
    // Tarayıcılar passkey'de http'yi yalnızca localhost için kabul eder.
    "Passkey": {
      "ServerDomain": "localhost",
      "Origins": [ "http://localhost:3000", "http://localhost:5280" ]
    }
//#endif
  },

  "Logs": {
    "FilePath": "logs/canapptemplate-.json"
  },

  // Mail:Provider = Smtp yapılırsa mailpit (docker) kullanılır; uygulama açılırken kendiliğinden başlatılır.
  // Gelen kutusu: http://localhost:8025
  "Mail": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  },
//#if (FileStorage)

  // Storage:Provider = Azure → azurite, S3 → seaweedfs (docker compose --profile storage up -d).
  "Storage": {
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      // SeaweedFS yerelde anahtar denetlemez; yine de bir değer gerekir: dotnet user-secrets set "Storage:S3:SecretAccessKey" "dev"
      "AccessKeyId": "canapptemplate"
    },
    "Azure": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "CreateContainerIfMissing": true
    }
  },
//#endif
//#if (Search)

  // docker-compose.yml'deki "elasticsearch" (uygulama açılırken başlatılır). Boş bırakırsan bellek içi motor.
  "Search": {
    "Elasticsearch": {
      "Url": "http://localhost:9200",
      "IndexPrefix": "canapptemplate-dev-",
      // Yazılan hemen aranabilsin (geliştirmede beklemeden görmek için).
      "Refresh": "WaitFor"
    }
  },
//#endif
//#if (Redis)

  // docker-compose.yml'deki "redis" (uygulama açılırken başlatılır). Boş bırakırsan bellek içi.
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
//#endif
//#if (EventBus)

  // docker-compose.yml'deki "rabbitmq" (uygulama açılırken başlatılır; arayüz http://localhost:15672).
  // Boş bırakırsan süreç içi taşıyıcı.
  "EventBus": {
    "RabbitMq": {
      "ConnectionString": "amqp://guest:guest@localhost:5672/"
    }
  },
//#endif

  // N+1 sorgularını geliştirirken yakala: aynı SQL bir istekte 10 kez çalışırsa uyarı.
  "QueryDiagnostics": {
    "RepeatedQueryThreshold": 10
  },

  // Geliştirme servisleri: uygulama açılırken servis bilgisayarda çalışıyorsa o kullanılır, yoksa docker-compose.yml'den
  // yalnızca o başlatılır (Docker Desktop açık olmalı). Production'da hiçbir şey yapmaz.
  // Servis başına: Compose = docker-compose.yml'deki servis adı, AddressFrom = uygulamanın bağlandığı adresin yazdığı ayar
  // (boşsa, dosyaysa ya da bu bilgisayar değilse başlatılmaz), When = koşul, Mode = Auto (önce bilgisayardaki, yoksa
  // docker) | Docker | Local (docker'a dokunma) | Off.
  "DevServices": {
    "Enabled": true,
    // Boşsa uygulama klasöründen yukarı doğru docker-compose.yml aranır.
    "ComposeFile": null,
    // Docker'da başlatılan servisin hazır olması için en fazla beklenecek süre.
    "StartTimeout": "00:02:00",
    "Services": {
      // Veritabanı (PersistenceServiceRegistration.cs → "Veritabanı"): seçtiğin sağlayıcının satırını aç.
      // "Database": { "Compose": "postgres", "AddressFrom": "ConnectionStrings:CanAppTemplate" },
      // "Database": { "Compose": "sqlserver", "AddressFrom": "ConnectionStrings:CanAppTemplate" },
//#if (Redis)
      "Redis": { "Compose": "redis", "AddressFrom": "Redis:ConnectionString" },
//#endif
//#if (Search)
      "Search": { "Compose": "elasticsearch", "AddressFrom": "Search:Elasticsearch:Url" },
//#endif
//#if (EventBus)
      "EventBus": { "Compose": "rabbitmq", "AddressFrom": "EventBus:RabbitMq:ConnectionString" },
//#endif
      "Mail": { "Compose": "mailpit", "AddressFrom": "Mail:Smtp", "When": "Mail:Provider=Smtp" }
    }
  }
//#if (Postman)
  ,

  // Postman: API her açılışta aynı koleksiyona aktarılır (değişmediyse istek atılmaz) ve baseUrl'li bir ortam
  // hazırlanır. (gizli) Anahtar olmadan hiçbir şey yapılmaz:
  //   dotnet user-secrets set "Postman:ApiKey" "PMAK-..."        dotnet user-secrets set "Postman:WorkspaceId" "<id>"
  "Postman": {
    "Enabled": true,
    "CollectionName": "CanAppTemplate API",
    "EnvironmentName": "CanAppTemplate - Development",
    // Ortamdaki baseUrl; boşsa uygulamanın dinlediği adres.
    "BaseUrl": null
  }
//#endif
}
