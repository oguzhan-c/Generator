{
  "ConnectionStrings": {
//#if (Postgres)
    // docker-compose.yml'deki "postgres" servisi (yalnızca yerel geliştirme şifresi; gerçek ortamda kullanılmaz).
    // Bilgisayarında kurulu PostgreSQL'i kullanacaksan kendi bağlantı dizesini user-secrets'a yaz; o bunu ezer.
    "CanAppTemplate": "Host=localhost;Port=5432;Database=canapptemplate;Username=canapptemplate;Password=canapptemplate"
//#elif (SqlServer)
    // docker-compose.yml'deki "sqlserver" servisi (yalnızca yerel geliştirme şifresi; gerçek ortamda kullanılmaz).
    // Bilgisayarında kurulu SQL Server'ı kullanacaksan kendi bağlantı dizesini user-secrets'a yaz; o bunu ezer.
    "CanAppTemplate": "Server=localhost,1433;Database=CanAppTemplate;User Id=sa;Password=CanAppTemplate_Dev_123;TrustServerCertificate=True"
//#else
    // Uygulamanın çalışma klasöründe bir dosya (docker gerekmez).
    "CanAppTemplate": "Data Source=canapptemplate.db"
//#endif
  },
  // Geliştirmede her açılışta veritabanı silinip güncel entity'lerden yeniden oluşturulur ve seed çalışır (entity
  // tasarlarken). Migration oluşturmaya başlayınca (dotnet ef migrations add Initial) Migrate yap: veri korunur.
  "Database": {
    "StartupMode": "Recreate"
  },
  // Geliştirme servisleri: uygulama açılırken servis bilgisayarda çalışıyorsa o kullanılır, yoksa docker-compose'dan
  // yalnızca o servis başlatılır (Docker Desktop açık olmalı). Servis başına:
  //   Auto   : önce bilgisayardaki, yoksa docker (varsayılan)
  //   Docker : her zaman docker
  //   Local  : yalnızca bilgisayardaki (docker'a dokunulmaz)
  //   Off    : hiçbir şey yapma
  // Servisler: Database, Mail (Mail:Provider = Smtp ise), Redis / Search / EventBus (adresleri yazılmışsa).
  "DevServices": {
    "Enabled": true,
    "Services": {
      "Database": "Auto"
    }
  },
//#if (Postman)
  // Postman: API her açılışta aynı koleksiyona aktarılır (değişmediyse istek atılmaz) ve baseUrl'li bir ortam
  // hazırlanır. Anahtar ve çalışma alanı GİZLİ, burada değil:
  //   dotnet user-secrets set "Postman:ApiKey" "PMAK-..."
  //   dotnet user-secrets set "Postman:WorkspaceId" "<çalışma alanı id'si>"     (boşsa varsayılan çalışma alanı)
  "Postman": {
    "Enabled": true,
    "CollectionName": "CanAppTemplate API",
    "EnvironmentName": "CanAppTemplate - Development"
  },
//#endif
  "Security": {
    "Cookies": {
      // http://localhost için; canlıda https ile Secure = true (varsayılan)
      "Secure": false
//#if (Passkey)
    },
    // Passkey (WebAuthn): tarayıcılar http'yi yalnızca localhost için kabul eder.
    // TODO(canfxgen): Canlıda ServerDomain ve Origins'i kendi alan adınla değiştir.
    "Passkey": {
      "ServerDomain": "localhost",
      "ServerName": "CanAppTemplate",
      "Origins": [ "http://localhost:3000", "http://localhost:5280" ]
//#endif
    }
  },
  "Logs": { "FilePath": "logs/canapptemplate-.json" },
  "Mail": {
    "Provider": "Pickup",
    "PickupDirectory": "mails",
    // Provider = Smtp: docker compose --profile mail up -d mailpit → arayüz http://localhost:8025
    "Smtp": { "Host": "localhost", "Port": 1025, "Security": "None", "FromAddress": "no-reply@canapptemplate.local", "FromName": "CanAppTemplate" }
  },
//#if (FileStorage)
  "Storage": {
    "Provider": "Local",
    "Local": { "RootPath": "files" },
    // Provider = Azure: docker compose --profile storage up -d azurite
    "Azure": { "ConnectionString": "UseDevelopmentStorage=true", "Container": "canapptemplate", "CreateContainerIfMissing": true },
    // Provider = S3: docker compose --profile storage up -d seaweedfs (anahtar: dotnet user-secrets set "Storage:S3:SecretAccessKey" ...)
    "S3": { "ServiceUrl": "http://localhost:9000", "Bucket": "canapptemplate", "Region": "us-east-1", "AccessKeyId": "canapptemplate" }
  },
//#endif
//#if (Search)
  // Arama: Url boşsa bellek içi motor; docker compose --profile search up -d elasticsearch → "http://localhost:9200"
  "Search": {
    "Elasticsearch": { "Url": "", "IndexPrefix": "canapptemplate-dev-", "Refresh": "WaitFor" }
  },
//#endif
//#if (Redis)
  // docker compose --profile cache up -d redis → "localhost:6379": önbellek, Data Protection, hız sınırı, kilit ortak olur.
  "Redis": { "ConnectionString": "" },
//#endif
//#if (EventBus)
  // docker compose --profile broker up -d rabbitmq → "amqp://guest:guest@localhost:5672/"
  "EventBus": {
    "RabbitMq": { "ConnectionString": "", "ConsumerName": "canapptemplate" }
  },
//#endif
//#if (Hangfire)
  // Kalıcı iş kuyruğu + cron + /hangfire (Admin). Tablolar aynı veritabanında.
  "Hangfire": { "Enabled": true },
//#endif
//#if (OpenTelemetry)
  // docker compose --profile observability up -d dashboard → http://localhost:18888
  "OpenTelemetry": { "Enabled": false, "Endpoint": "http://localhost:4317" },
//#endif
  "QueryDiagnostics": {
    "RepeatedQueryThreshold": 10
  }
}
