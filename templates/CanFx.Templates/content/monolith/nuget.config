<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CanFx paketleri nuget.org'dan gelir. Yerel ya da özel bir kaynak kullanacaksan (ör. yayınlanmamış sürüm):
         <add key="canfx" value="/yol/CanFx/artifacts/packages" />  ve aşağıya CanFx.* eşlemesini ekle. -->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
